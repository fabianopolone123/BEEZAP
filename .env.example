SECRET_KEY=troque-esta-chave
DEBUG=False
ALLOWED_HOSTS=beezap.seudominio.com,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://beeonboard.seudominio.com

# Prefixo de caminho quando o app roda sob um sub-caminho (ex.: dominio.com/beeonboard/).
# Faz o Django gerar todas as URLs (links, redirects) com o prefixo. Deixe vazio
# se o app roda na raiz de um dominio proprio.
FORCE_SCRIPT_NAME=/beeonboard

# URL publica dos arquivos estaticos e de midia.
# - Padrao (dominio proprio): /static/  e  /media/
# - Se o app roda sob um prefixo de caminho (ex.: dominio.com/beeonboard/): /beeonboard/static/ e /beeonboard/media/
STATIC_URL=/beeonboard/static/
MEDIA_URL=/beeonboard/media/

# SQLite temporario para homologacao simples:
DATABASE_URL=sqlite:////var/www/beezap/db.sqlite3

# PostgreSQL recomendado para evolucao:
# DATABASE_URL=postgresql://beezap_user:troque-a-senha@127.0.0.1:5432/beezap_db

WAPI_BASE_URL=https://api.w-api.app
WAPI_INSTANCE_ID=
WAPI_TOKEN=
WAPI_WEBHOOK_TOKEN=

# Integracao com o GPT (OpenAI). A API Key normalmente e cadastrada na tela
# Inteligencia (IA) e fica salva no banco; estas variaveis sao apenas fallback.
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-nano
OPENAI_TIMEOUT=30

# ---------------------------------------------------------------------------
# Cookies (opcional — os padroes do settings.py ja sao proprios do BEEonBOARD)
# ---------------------------------------------------------------------------
# O dominio serve varios sistemas Django sob prefixos diferentes. Com o nome padrao
# do Django (`sessionid`) no caminho `/`, os sistemas sobrescrevem a sessao um do
# outro — entrar num derruba o login do outro. O settings.py ja usa nomes proprios;
# estas variaveis existem so para o caso de precisar mudar sem editar codigo.
# SESSION_COOKIE_NAME=beeonboard_sessionid
# CSRF_COOKIE_NAME=beeonboard_csrftoken
# SESSION_COOKIE_PATH=/beeonboard/

# HSTS vale para o DOMINIO INTEIRO (nao so /beeonboard/) e um max-age alto e difícil
# de desfazer — por isso vem desligado. Ligar so com decisao consciente.
# SECURE_HSTS_SECONDS=31536000

# ---------------------------------------------------------------------------
# W-API: NAO use mais estas variaveis num ambiente com mais de um cliente
# ---------------------------------------------------------------------------
# A credencial de cada empresa fica no BANCO (tela WhatsApp/W-API, so o master).
# O fallback para estas variaveis vale SOMENTE para a empresa padrao — para um
# cliente novo sem credencial nao acabar enviando pelo WhatsApp de outro.
# O `manage.py check` avisa (beezap.W002) se elas estiverem preenchidas com mais de
# uma empresa cadastrada.
# WAPI_INSTANCE_ID=
# WAPI_TOKEN=

# ---------------------------------------------------------------------------
# AVISO DE NOVA MENSAGEM (Web Push) — chaves VAPID
# ---------------------------------------------------------------------------
# Sem estas chaves o pop-up de nova mensagem NAO chega com a aba em segundo plano
# (o `manage.py check` avisa: beezap.W003). O aviso antigo dependia de um timer de 6s
# na tela, e o Chrome estrangula timer de aba oculta para 1x/minuto.
#
# Gerar o par UMA vez, no servidor:  python manage.py gerar_chaves_vapid
# A chave PRIVADA e segredo: nunca versionar. Trocar o par obriga todos os
# navegadores a se inscreverem de novo.
# WEBPUSH_VAPID_PUBLIC_KEY=
# WEBPUSH_VAPID_PRIVATE_KEY=
# WEBPUSH_VAPID_SUBJECT=mailto:contato@seudominio.com
