# ==========================================================================
# OPCAO A — BEEZAP em dominio proprio (ex.: beezap.seudominio.com)
# ==========================================================================
server {
    listen 80;
    server_name beezap.seudominio.com;

    client_max_body_size 20M;

    location /static/ {
        alias /var/www/beezap/staticfiles/;
    }

    # ATENCAO: servir /media/ inteiro deixa a midia das conversas (foto, audio,
    # video, documento) publica para quem souber o caminho. Libere SO os logos das
    # empresas; a midia sai pela view autenticada do Django (/midia/<id>/).
    location /media/empresas/ {
        alias /var/www/beezap/media/empresas/;
    }

    location / {
        proxy_pass http://127.0.0.1:8006;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120;
        proxy_connect_timeout 60;
        proxy_redirect off;
    }
}

# ==========================================================================
# OPCAO B (RECOMENDADA no VPS atual) — BEEZAP sob o prefixo /beeonboard/
# Ex.: https://fabianopolone.com.br/beeonboard/
#
# Inserir estes blocos dentro do server { } do dominio ja existente
# (no VPS atual: /etc/nginx/sites-available/site_idiomas) e definir no .env:
#     STATIC_URL=/beeonboard/static/
#
# Vantagem: o CSS/JS do BEEZAP e servido direto da pasta-fonte `static/`,
# entao um simples `git pull` ja publica as alteracoes — sem `collectstatic`
# nem `cp -r static/* staticfiles/`.
# ==========================================================================

# 1) Estaticos do Django admin: coletados uma vez pelo collectstatic.
#    (Precisa ser ANTES do bloco /beeonboard/static/ — prefixo mais especifico.)
location /beeonboard/static/admin/ {
    alias /var/www/beezap/staticfiles/admin/;
    access_log off;
    expires 7d;
}

# 2) Estaticos do proprio BEEZAP (css/js/images) servidos da pasta-fonte.
location /beeonboard/static/ {
    alias /var/www/beezap/static/;
    access_log off;
}

# 3) MIDIA — cuidado aqui.
#
# NAO servir /beeonboard/media/ inteiro. A pasta `media/whatsapp/` guarda as fotos,
# audios, videos e documentos das conversas dos CLIENTES: servida direto pelo
# Nginx, ela fica acessivel a qualquer um que descubra o caminho, sem login e sem
# checagem de empresa. Essa midia sai pela view autenticada do Django
# (`/beeonboard/midia/<id>/`), que aplica as regras da conversa, e a W-API baixa a
# midia enviada por um link assinado e temporario (`/beeonboard/midia-publica/...`).
#
# Aqui fica publica apenas a pasta dos LOGOS das empresas, que aparecem na barra
# lateral e nao tem nada de conversa.
location /beeonboard/media/empresas/ {
    alias /var/www/beezap/media/empresas/;
    access_log off;
}

location /beeonboard/ {
    proxy_pass http://127.0.0.1:8006/;   # porta do gunicorn do BEEZAP (ver deploy/beezap.service.example)
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120;
    proxy_connect_timeout 60;
    proxy_redirect off;
}
